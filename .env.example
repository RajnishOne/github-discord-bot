# ==============================================================================
# RepoBeacon Environment Configuration
# Copy this file to .env and configure your values.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
TZ=Asia/Kolkata
PUID=1000
PGID=100

# Persistent Data Storage path on host
DATA_PATH=/docker-data/repo-beacon/data

# ------------------------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------------------------

# Your GitHub username or organization (used for ownership verification)
GITHUB_OWNER=RajnishOne

# Webhook Secret configured in your GitHub App / Repository Webhook settings
# Used to verify HMAC-SHA256 signatures on inbound webhook requests
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_token_here

# GitHub Personal Access Token (PAT) or GitHub App Installation Token
# Optional for basic public repo polling, but RECOMMENDED to increase rate limits
# from 60 requests/hr (unauthenticated) to 5,000 requests/hr (authenticated)
# and to enable automatic discovery of newly created public repositories.
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# ------------------------------------------------------------------------------
# Discord Notifications (Zero-Touch Container Setup via Web UI)
# ------------------------------------------------------------------------------
# You do NOT need to configure Discord in this file!
# Configure your Discord Bot Token, Application Client ID, Default Channel ID,
# and secondary Webhooks directly inside the Web UI dashboard (⚙️ Settings).
# All settings are saved securely to SQLite in DATA_PATH and connect instantly
# without restarting the container.
#
# Optional: Environment variable overrides if pre-seeding credentials
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_CHANNEL_ID=
# DISCORD_GUILD_ID=
# DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Security & Administrative Controls
# ------------------------------------------------------------------------------

# Optional API key to protect administrative endpoints (/api/admin/*)
# Leave blank to disable admin endpoint authentication during local testing
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------------------------
# Polling Adapter Configuration
# ------------------------------------------------------------------------------

# Default polling frequency (in seconds) for watched external public repositories
# Default: 300 (5 minutes)
DEFAULT_POLLING_INTERVAL=300
